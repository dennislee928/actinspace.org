# =============================================================================
# Environment variables – copy to .env and fill values. Do not commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Space-SOC Backend
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use SUPABASE_DATABASE_URL
# (Supabase) or SQLite (local dev).
DATABASE_URL=

# Supabase: use when DATABASE_URL is empty (production). From Supabase dashboard:
# Project Settings → Database → Connection string (URI).
SUPABASE_DATABASE_URL=

PORT=8080

# ACRI-ST resource link (GET /api/v1/resources)
ACRI_ST_FOLDER_URL=

# CLMS JWT (Scheduler/Fetcher). From land.copernicus.eu Service Key.
CLMS_CLIENT_ID=
CLMS_PRIVATE_KEY=
CLMS_TOKEN_URI=
CLMS_USER_ID=
# Optional: manual Bearer token for CLMS proxy
CLMS_BEARER_TOKEN=
CLMS_SCHEDULER_INTERVAL=2m

# S2GM Watcher
S2GM_WATCH_DIR=
S2GM_WATCH_INTERVAL=1m

# Object Storage (non-relational): Cloudflare R2 or S3-compatible.
# R2: Dashboard → R2 → bucket → Settings → S3 API endpoint.
# Example R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=

# Optional: EPO OPS patents API
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# Optional: Enterprise license
ACTINSPACE_LICENSE_KEY=

# -----------------------------------------------------------------------------
# Other components (EO/ACRI-ST/S2GM/CLMS via Space-SOC API)
# -----------------------------------------------------------------------------
# ttc-gateway, ota-controller: event ingestion and Space-SOC API (resources, jobs, assets)
SPACE_SOC_URL=

# ota-controller
DATABASE_PATH=

# satellite-sim
OTA_CONTROLLER_URL=
VERSION=

# ttc-gateway
SATELLITE_SIM_URL=
