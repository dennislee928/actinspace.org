# Space-SOC Backend – copy to .env and set values. Do not commit .env.

# Database: leave empty to use SUPABASE_DATABASE_URL (Supabase) or SQLite (dev)
DATABASE_URL=
SUPABASE_DATABASE_URL=

PORT=8080

ACRI_ST_FOLDER_URL=

CLMS_CLIENT_ID=
CLMS_PRIVATE_KEY=
CLMS_TOKEN_URI=
CLMS_USER_ID=
CLMS_BEARER_TOKEN=
CLMS_SCHEDULER_INTERVAL=2m

S2GM_WATCH_DIR=
S2GM_WATCH_INTERVAL=1m

# Object Storage: Cloudflare R2 (S3-compatible) or MinIO/S3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=

EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
ACTINSPACE_LICENSE_KEY=
